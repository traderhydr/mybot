TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHANNEL_ID=@your_channel
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-3.8-flash
GEMINI_COOLDOWN_MINUTES=30
GEMINI_RPM=8                           # lower this if you still see HTTP 429
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-haiku-5-5
SYMBOLS=ALL                            # ALL = every USDT perpetual, or BTCUSDT,ETHUSDT
MIN_24H_VOLUME_USDT=0                  # e.g. 5000000 to skip illiquid coins
MAX_COINS=0                            # e.g. 100 = only the 100 most-traded coins
COIN_DELAY_SECONDS=3
TIMEFRAME=1h
INTERVAL_MINUTES=240

# ---- v2 engine (STRATEGY=v2): multi-timeframe + volume + BTC context + derivatives + persistent state ----
# STRATEGY=v1                  # v1 = original single-timeframe bot (default). Set v2 only after a --dry test.
# ENTRY_TIMEFRAME=15m          # 5m, 15m, 30m, 1h ... (4h and 1d are always fetched as higher timeframes)
# INTERVAL_MINUTES=60          # scan cycle (v2 default 60)
# COOLDOWN_HOURS=8             # after a signal closes (or is cancelled), no LLM call for this long
# FLIP_LOCK_HOURS=24           # then, until this long after the last signal, only the same direction is allowed
# EXPIRY_HOURS=48              # open signals are closed at market after this long
# RVOL_MIN=1.2                 # relative volume gate (also checked in code before any LLM call)
# MIN_CONFIDENCE=0.6
# MIN_RR=1.5                   # reward:risk on the reference entry
# MIN_RR_LADDER=1.2            # reward:risk on the average of the 4 ladder entries
# MAX_SL_PCT=0.05              # stop no further than 5% of price (50% of margin at 10x)
# LADDER_STEP_ATR=0.2          # spacing of the 4 entries, in entry-timeframe ATR
# PREGATE_RVOL=1               # 1 = skip the LLM when RVOL is below RVOL_MIN
# STATE_DB=bot_state.db
