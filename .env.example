TELEGRAM_BOT_TOKEN=123456:ABC...        # from @BotFather
TELEGRAM_CHANNEL_ID=@your_channel       # or -100xxxxxxxxxx; bot must be channel admin
ANTHROPIC_API_KEY=sk-ant-...
# Optional: set this to use DeepSeek instead of Claude
# DEEPSEEK_API_KEY=sk-...
CLAUDE_MODEL=claude-sonnet-5-5
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT
TIMEFRAME=1h
INTERVAL_MINUTES=240                    # how often to post a signal
# Optional: any OpenAI-compatible endpoint (takes priority over DeepSeek/Claude)
# OPENAI_BASE_URL=https://example.com/openai/v1
# OPENAI_API_KEY=...
# OPENAI_MODEL=gpt-5.4
